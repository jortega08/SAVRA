# Plantilla documental; Render recibe estos valores desde su panel, nunca de Git.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require&connect_timeout=15
PUBLIC_ORIGIN=https://YOUR-SERVICE.onrender.com
CONSENT_SECRET=GENERATE_AND_KEEP_THE_EXISTING_LOCAL_SECRET
FINGERPRINT_SECRET=GENERATE_AND_KEEP_THE_EXISTING_LOCAL_SECRET
DATA_MODE=real
MIN_GROUP_SIZE=5
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
# Render proporciona PORT automáticamente. El contenedor usa 10000 por defecto.
